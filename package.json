{
  "name": "knowledge-graph",
  "private": true,
  "version": "1.2.2",
  "description": "本地优先的知识图谱笔记应用",
  "author": "Zengyi Xu",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "lint": "eslint .",
    "frozen:check": "node scripts/frozen-check.mjs",
    "frozen:update": "node scripts/frozen-check.mjs --update",
    "test:frozen": "node scripts/frozen-check.mjs --run-guards",
    "budget:check": "node scripts/bundle-budget.mjs",
    "budget:report": "node scripts/bundle-budget.mjs --report",
    "budget:baseline": "node scripts/bundle-budget.mjs --update",
    "budget:modules": "node scripts/bundle-modules.mjs",
    "test:bundle-scenarios": "node scripts/bundle-scenarios.mjs",
    "test:vault": "esbuild scripts/vault-selftest.ts --bundle --platform=node --format=cjs --target=node20 --alias:@=./src --outfile=.tmp-vault-test/selftest.cjs && node .tmp-vault-test/selftest.cjs",
    "test:use-notes": "esbuild scripts/use-notes-selftest.ts --bundle --platform=node --format=cjs --target=node20 --alias:@=./src --alias:react=./scripts/harness/react-shim.ts --outfile=.tmp-vault-test/use-notes-selftest.cjs && node .tmp-vault-test/use-notes-selftest.cjs",
    "test:vault-gate": "esbuild scripts/vault-gate-selftest.ts --bundle --platform=node --format=cjs --target=node20 --alias:@=./src --outfile=.tmp-vault-test/vault-gate.cjs && node .tmp-vault-test/vault-gate.cjs",
    "test:ai-chat": "esbuild scripts/ai-chat-selftest.ts --bundle --platform=node --format=cjs --target=node20 --alias:@=./src --outfile=.tmp-vault-test/ai-chat-selftest.cjs && node .tmp-vault-test/ai-chat-selftest.cjs",
    "test:lit": "esbuild scripts/literature-selftest.ts --bundle --platform=node --format=cjs --target=node20 --alias:@=./src --outfile=.tmp-vault-test/lit-selftest.cjs && node .tmp-vault-test/lit-selftest.cjs",
    "test:note-list": "esbuild scripts/note-list-selftest.tsx --bundle --platform=node --format=cjs --target=node20 --jsx=automatic --alias:@=./src --outfile=.tmp-vault-test/note-list-selftest.cjs && node .tmp-vault-test/note-list-selftest.cjs",
    "test:lit-view": "esbuild scripts/literature-view-selftest.tsx --bundle --platform=node --format=cjs --target=node20 --jsx=automatic --alias:@=./src --outfile=.tmp-vault-test/lit-view-selftest.cjs && node .tmp-vault-test/lit-view-selftest.cjs",
    "test:lit-dom": "node scripts/lit-view-dom-test.mjs",
    "test:vault-e2e": "node scripts/vault-e2e.mjs",
    "test:md": "node scripts/md-selftest.mjs",
    "test:md-import": "esbuild scripts/md-import-selftest.ts --bundle --platform=node --format=cjs --target=node20 --alias:@=./src --outfile=.tmp-vault-test/md-import-selftest.cjs && node .tmp-vault-test/md-import-selftest.cjs",
    "test:md-render": "esbuild scripts/md-ssr-entry.tsx --bundle --platform=node --format=cjs --target=node20 --alias:@=./src --outfile=.tmp-md-visual/ssr.cjs && node .tmp-md-visual/ssr.cjs",
    "test:math": "esbuild scripts/math-render-selftest.ts --bundle --platform=node --format=cjs --target=node20 --alias:@=./src --outfile=.tmp-math-visual/selftest.cjs && node .tmp-math-visual/selftest.cjs",
    "visual:md": "node scripts/md-visual.mjs",
    "visual:math": "node scripts/math-visual.mjs",
    "preview": "vite preview",
    "web:local": "node scripts/local-web.mjs",
    "test:web": "node scripts/local-web-selftest.mjs",
    "test:web-portable": "node scripts/test-web-portable.mjs",
    "test:mobile": "node scripts/mobile-responsive-check.mjs",
    "icons:build": "node scripts/make-pwa-icons.mjs",
    "zotero:build": "esbuild scripts/zotero-vault-sync.ts --bundle --platform=node --format=cjs --target=node20 --alias:@=./src --outfile=.tmp-zotero/zotero-vault-sync.cjs",
    "zotero:sync": "npm run zotero:build && node .tmp-zotero/zotero-vault-sync.cjs",
    "test:zotero": "node scripts/zotero-selftest.mjs",
    "test:zotero-import": "esbuild scripts/zotero-import-selftest.ts --bundle --platform=node --format=cjs --target=node20 --alias:@=./src --outfile=.tmp-vault-test/zotero-import-selftest.cjs && node .tmp-vault-test/zotero-import-selftest.cjs",
    "test:zotero-e2e": "npm run zotero:build && npm run dedupe:build && node scripts/zotero-import-e2e.mjs",
    "dedupe:build": "esbuild scripts/dedupe-vault.ts --bundle --platform=node --format=cjs --target=node20 --alias:@=./src --outfile=.tmp-vault-test/dedupe.cjs",
    "dedupe:vault": "npm run dedupe:build && node .tmp-vault-test/dedupe.cjs",
    "cluster:report": "esbuild scripts/lit-cluster-report.ts --bundle --platform=node --format=cjs --target=node20 --alias:@=./src --outfile=.tmp-cluster/report.cjs && node .tmp-cluster/report.cjs",
    "test:wysiwyg-e2e": "node scripts/wysiwyg-e2e.mjs",
    "verify:word": "node scripts/word-field-verify.mjs",
    "test:startup": "esbuild scripts/perf-startup.ts --bundle --platform=node --format=cjs --target=node20 --alias:@=./src --outfile=.tmp-vault-test/perf.cjs && node .tmp-vault-test/perf.cjs",
    "test:startup-e2e": "node scripts/startup-e2e.mjs",
    "desktop:dev": "npm run build:dev && electron .",
    "release:web": "node scripts/package-web-portable.mjs",
    "pdf:build": "esbuild scripts/link-local-pdfs.ts --bundle --platform=node --format=cjs --target=node20 --alias:@=./src --outfile=.tmp-vault-test/link-pdfs.cjs",
    "pdf:link": "npm run pdf:build && node .tmp-vault-test/link-pdfs.cjs",
    "tags:strip-direction": "esbuild scripts/strip-direction-tags.ts --bundle --platform=node --format=cjs --target=node20 --alias:@=./src --outfile=.tmp-vault-test/strip-direction-tags.cjs && node .tmp-vault-test/strip-direction-tags.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "better-sqlite3": "^13.0.3",
    "citation-js": "^0.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "katex": "^0.19.0",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.70.0",
    "react-resizable-panels": "^4.2.2",
    "react-router": "^7.6.1",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "vditor": "^4.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "electron": "^44.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "kimi-plugin-inspect-react": "^1.0.3",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^6.1.2",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "esbuild@0.27.2": true
  }
}
